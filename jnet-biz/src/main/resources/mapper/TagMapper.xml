<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jnet.biz.mapper.TagMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jnet.biz.entity.Tag">
        <id column="tag_id" property="tagId"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="category" property="category"/>
        <result column="parent_id" property="parentId"/>
        <result column="color_code" property="colorCode"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="is_system" property="isSystem"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        tag_id, name, code, category, parent_id, color_code, 
        sort_order, is_system, create_by, create_time, update_by, update_time
    </sql>

</mapper>
