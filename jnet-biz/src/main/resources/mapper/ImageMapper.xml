<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jnet.biz.mapper.ImageMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jnet.biz.entity.Image">
        <id column="image_id" property="imageId"/>
        <result column="batch_id" property="batchId"/>
        <result column="filename" property="filename"/>
        <result column="file_path" property="filePath"/>
        <result column="pathology_id" property="pathologyId"/>
        <result column="patient_id" property="patientId"/>
        <result column="format" property="format"/>
        <result column="lifecycle_status" property="lifecycleStatus"/>
        <result column="annotation_progress" property="annotationProgress"/>
        <result column="width" property="width"/>
        <result column="height" property="height"/>
        <result column="mpp_x" property="mppX"/>
        <result column="mpp_y" property="mppY"/>
        <result column="magnification" property="magnification"/>
        <result column="file_size" property="fileSize"/>
        <result column="scanner_info" property="scannerInfo" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="metadata" property="metadata" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="thumbnail_url" property="thumbnailUrl"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="del_flag" property="delFlag"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        image_id, batch_id, filename, file_path, pathology_id, patient_id, 
        format, lifecycle_status, annotation_progress, width, height, 
        mpp_x, mpp_y, magnification, file_size, scanner_info, metadata, 
        thumbnail_url, create_by, create_time, update_by, update_time, del_flag
    </sql>

</mapper>
