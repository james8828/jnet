<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jnet.biz.mapper.TaskMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jnet.biz.entity.Task">
        <id column="task_id" property="taskId"/>
        <result column="task_no" property="taskNo"/>
        <result column="type" property="type"/>
        <result column="project_id" property="projectId"/>
        <result column="model_version" property="modelVersion"/>
        <result column="config_snapshot" property="configSnapshot" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="progress" property="progress"/>
        <result column="status" property="status"/>
        <result column="result_summary" property="resultSummary" typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="error_message" property="errorMessage"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="duration_seconds" property="durationSeconds"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        task_id, task_no, type, project_id, model_version, config_snapshot, 
        progress, status, result_summary, error_message, start_time, 
        end_time, duration_seconds, create_by, create_time, update_by, update_time
    </sql>

</mapper>
