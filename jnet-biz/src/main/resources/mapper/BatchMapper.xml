<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jnet.biz.mapper.BatchMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.jnet.biz.entity.Batch">
        <id column="batch_id" property="batchId"/>
        <result column="project_id" property="projectId"/>
        <result column="batch_code" property="batchCode"/>
        <result column="batch_name" property="batchName"/>
        <result column="scanner_model" property="scannerModel"/>
        <result column="staining_protocol" property="stainingProtocol"/>
        <result column="storage_root_path" property="storageRootPath"/>
        <result column="total_images" property="totalImages"/>
        <result column="upload_status" property="uploadStatus"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        batch_id, project_id, batch_code, batch_name, scanner_model, 
        staining_protocol, storage_root_path, total_images, upload_status, 
        create_by, create_time, update_by, update_time
    </sql>

</mapper>
